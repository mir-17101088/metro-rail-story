{
  "name": "mrt-story",
  "private": true,
  "version": "1.0.0",
  "description": "The Daily Star visual story “Dhaka’s Metro Rail: Essential Transport, Escalating Costs”",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "node scripts/build-network.mjs",
    "dev": "vite",
    "build": "npm run data && npm run typecheck && vite build",
    "preview": "npm run build && node server/node-server.mjs",
    "start": "node server/node-server.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "mapbox-gl": "^3.30.0"
  },
  "devDependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.3",
    "@xmldom/xmldom": "^0.9.8",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
